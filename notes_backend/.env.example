# Example environment variables for Notes Backend (do not commit secrets)

# Either provide a full DSN:
# MYSQL_URL=mysql+pymysql://user:password@mysql-host:3306/notes_db

# Or provide discrete settings:
# MYSQL_USER=notes_user
# MYSQL_PASSWORD=notes_password
# MYSQL_DB=notes_db
# MYSQL_PORT=3306
# MYSQL_HOST=notes_database

# CORS configuration for local dev frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
